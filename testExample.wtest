import example.*

test"La velocidad de tito con sus valores iniciales es: 7"{
  tito.consumir(10, terere)
  assert.equals(7, tito.velocidad())
}

test "La velocidad de pepe si consume 10 de cianuro es "{
  pepe.consumir(10, cianuro)
  assert.equals(10.8*490/80, pepe.velocidad())
}

test "Tito es feliz si corre a mas de 7 de velocidad"{
  tito.consumir(10, terere)
  assert.that(tito.esFeliz())
}

test "Tito no es feliz si consume cianuro"{
  tito.consumir(10, cianuro)
  assert.notThat(tito.esFeliz())
}